{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemCode",
  "version": "0.4.0-beta.26",
  "identifier": "com.memtrace.memcode",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5197"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MemCode",
        "create": false,
        "width": 1512,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 620,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#f3f7f4",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:5197; media-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMjU4NEFFODY4MTc4MTcKUldRWGVJR0dyb1FsYmFXRGZxZDlrUFBSU1V2KzQ5T0dCa1NiQnhYeU1CNkcyVjd4WnhRd0J1SEwK",
      "endpoints": [
        "https://www.memtrace.io/api/memcode/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": true,
    "resources": {
      "../dist-desktop-runtime/": "desktop-runtime/",
      "../third_party/": "third-party/",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../dist-runtime/service.cjs": "runtime/service.cjs",
      "../dist-runtime/context-gateway.cjs": "runtime/context-gateway.cjs",
      "../dist-runtime/team-relay.cjs": "runtime/team-relay.cjs",
      "../dist-artifact-viewer/": "artifact-viewer/",
      "../dist-artifact-annotations/": "artifact-annotations/",
      "../node_modules/playwright-core/": "runtime/node_modules/playwright-core/"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.app.plist",
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": {
          "width": 720,
          "height": 508
        },
        "appPosition": {
          "x": 180,
          "y": 272
        },
        "applicationFolderPosition": {
          "x": 540,
          "y": 272
        }
      }
    }
  }
}
